# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kecbiofuel

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS - your admin panel / frontend origin(s), comma separated
CLIENT_URL=http://localhost:3000

# One-time setup key required to create the very first admin account
# via POST /api/auth/register. Change this, keep it secret, and you
# can remove/rotate it once your admin accounts are created.
ADMIN_SETUP_KEY=replace_with_a_setup_key

# Used only by `npm run seed:admin` to create a default admin from the CLI
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@kecbiofuel.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# Max thumbnail upload size in MB
MAX_UPLOAD_MB=5
